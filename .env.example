# X OAuth2 user access token (from your auth flow). Required for sweep.
# Prefer a dedicated X developer app for bookmarks.
X_ACCESS_TOKEN=

# Optional: path to a JSON token file written by your OAuth helper.
# Expected keys: access_token, and optionally expires_at (unix), refresh_token
# X_OAUTH_TOKEN_FILE=./oauth2_tokens.json

# Optional: if you use x-cli for OAuth refresh only
# X_CLI_PATH=x-cli

# --- Optional Discord forum mirror ---
DISCORD_BOT_TOKEN=
DISCORD_FORUM_CHANNEL_ID=

# Category name -> Discord forum tag snowflake (JSON object as a single line)
# DISCORD_TAG_IDS={"ai-llm":"123","infra-devops":"456","other":"789"}

# Optional OpenAI-compatible LLM for classify fallback when regex returns "other"
# CLASSIFY_LLM_URL=http://127.0.0.1:8088
# CLASSIFY_USE_LLM=0
